{
  "name": "lumicomic",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:prototype": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "build:prototype": "tsc --noEmit && vite build --mode ui-prototype",
    "preview:prototype": "vite preview --outDir prototype-dist --host 127.0.0.1 --port 4180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "build:ios": "tsc --noEmit && vite build --mode ios && cap sync ios",
    "build:ios:prototype": "tsc --noEmit && vite build --mode ios-prototype && cap sync ios",
    "check:ios": "node scripts/check-ios.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test-books": "python scripts/make_test_books.py test-books"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@preact/signals": "^2.11.3",
    "dexie": "4.4.6",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
