            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <!-- 系统背景色 + 居中小图标（散装 PNG，不放资源目录）：整屏大图会超过系统启动图 25 MB 渲染上限而黑屏；
